# Copy to .env and replace secrets locally. Never commit .env.
WEB_PASSWORD=replace-me
WEB_ADMIN_PASSWORD=replace-with-a-different-admin-password
WEB_SECRET_KEY=replace-with-a-long-random-value
WEB_PORT=8080
WEB_BIND=127.0.0.1
REDIS_HOST=redis
MIN_FREE_DISK_GB=2
ORYX_STREAM_URL=http://stream-host/live/stream.flv
TELEGRAM_BOT_TOKEN=
CAPTURE_STARTUP_TIMEOUT=30
CAPTURE_IDLE_TIMEOUT=60
CAPTURE_STOP_TIMEOUT=10
FINALIZE_TIMEOUT=600
PROBE_TIMEOUT=20

# Recently-ended YouTube livestreams can expose a temporary post-live manifest.
# StreamFetch refreshes metadata and resumes the same .part files with bounded backoff.
YOUTUBE_POSTLIVE_ATTEMPTS=3
YOUTUBE_POSTLIVE_RETRY_DELAY=20

# Cloudflare Workers AI is primary in auto mode. Transient Cloudflare failures
# fall back to CPU-only faster-whisper; authentication/configuration failures do not.
TRANSCRIPTION_PROVIDER=auto
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TRANSCRIPTION_CONCURRENCY=3
CLOUDFLARE_TRANSCRIPTION_CHUNK_SECONDS=300
CLOUDFLARE_TRANSCRIPTION_CHUNK_OVERLAP_SECONDS=2
CLOUDFLARE_TRANSCRIPTION_TIMEOUT=120

# Local faster-whisper fallback. Models persist under ./data/whisper-models.
WHISPER_CPU_THREADS=4
TRANSCRIPTION_CPUS=4.0
TRANSCRIPTION_MEMORY_LIMIT=8g

# Optional asynchronous archive. ARCHIVE_HOST_PATH is read only by Compose;
# application code uses ARCHIVE_PATH inside the worker container.
ARCHIVE_ENABLED=false
ARCHIVE_HOST_PATH=./archive
ARCHIVE_PATH=/archive
ARCHIVE_LOCAL_RETENTION_HOURS=24
ARCHIVE_MAX_RETRIES=3
ARCHIVE_RETRY_BASE_SECONDS=60
